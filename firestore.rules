rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.email == "owner@example.com";
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }
  }
}
